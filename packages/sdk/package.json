{
  "name": "@relayservice/sdk",
  "version": "0.1.0",
  "description": "Official SDK for Relay — BYOK AI infrastructure. Let your users bring their own OpenAI/Anthropic/Google keys; you never see them.",
  "keywords": ["relay", "byok", "ai", "openai", "anthropic", "gemini", "proxy", "sdk"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/salarifyteam/relay_stripe",
    "directory": "packages/sdk"
  },
  "homepage": "https://vault.relayservice.im",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "openai": ">=4 <6"
  },
  "devDependencies": {
    "openai": "^5.12.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
